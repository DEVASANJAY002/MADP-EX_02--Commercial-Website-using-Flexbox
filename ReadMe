style.css
```
/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', sans-serif;
  background-color: #f5f5f5;
  color: #333;
}

a {
  text-decoration: none;
  color: inherit;
}

header {
  background-color: #1a1a2e;
  padding: 1.2rem 2rem;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 1.8rem;
  font-weight: bold;
  color: #f39c12;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 1.5rem;
}

.nav-links a {
  color: #fff;
  font-weight: 500;
  transition: color 0.3s ease;
}

.nav-links a:hover {
  color: #f39c12;
}

.hero {
  background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://via.placeholder.com/1200x500') center/cover no-repeat;
  color: white;
  padding: 6rem 2rem;
  text-align: center;
}

.hero-content h1 {
  font-size: 2.8rem;
  margin-bottom: 1rem;
}

.hero-content p {
  font-size: 1.2rem;
  margin-bottom: 1.5rem;
}

.btn-primary {
  padding: 0.75rem 1.5rem;
  background-color: #f39c12;
  color: white;
  font-weight: bold;
  border-radius: 5px;
  transition: background-color 0.3s;
}

.btn-primary:hover {
  background-color: #d35400;
}

.section {
  padding: 4rem 2rem;
  text-align: center;
}

.features-grid, .product-container, .testimonial-grid {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 2rem;
  margin-top: 2rem;
}

.feature-box {
  background: white;
  padding: 2rem;
  width: 280px;
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.feature-box i {
  font-size: 2rem;
  color: #f39c12;
  margin-bottom: 0.5rem;
}

.product-card, .testimonial-card {
  background: white;
  padding: 1rem;
  width: 280px;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.08);
  transition: transform 0.3s;
}

.product-card:hover, .testimonial-card:hover {
  transform: translateY(-5px);
}

.product-card img {
  width: 100%;
  border-radius: 5px;
  margin-bottom: 1rem;
}

.testimonial-card p {
  font-style: italic;
  margin-bottom: 0.5rem;
}

.newsletter {
  background-color: #f39c12;
  color: white;
  padding: 3rem 2rem;
}

.newsletter-form {
  margin-top: 1rem;
}

.newsletter-form input {
  padding: 0.7rem;
  border: none;
  border-radius: 4px;
  width: 250px;
  margin-right: 0.5rem;
}

.newsletter-form button {
  padding: 0.7rem 1rem;
  background-color: #1a1a2e;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: bold;
}

.newsletter-form button:hover {
  background-color: #000;
}

footer {
  background-color: #1a1a2e;
  color: white;
  padding: 2rem 1rem;
  text-align: center;
}

.social-icons a {
  margin: 0 0.5rem;
  font-size: 1.3rem;
  color: white;
  transition: color 0.3s;
}

.social-icons a:hover {
  color: #f39c12;
}

/* Responsive */
@media (max-width: 768px) {
  .nav-links {
    flex-direction: column;
    gap: 1rem;
  }

  .features-grid, .product-container, .testimonial-grid {
    flex-direction: column;
    align-items: center;
  }

  .newsletter-form input {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .newsletter-form {
    flex-direction: column;
    align-items: center;
  }
}
```


